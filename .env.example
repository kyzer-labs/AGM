# =============================================================================
# AGM Voting Site — environment variables
# Copy this file to `.env.local` and fill in real values from the
# Firebase and Convex consoles. See docs/SETUP.md for full instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Web App config (public — safe to expose to the browser)
# Source: Firebase Console > Project Settings > General > Your apps > Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional but typical Firebase fields:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Microsoft OAuth tenant. Use one of:
#   "common"        — work, school, or personal Microsoft accounts
#   "organizations" — any Microsoft work or school account
#   <tenant-id>     — restrict to a specific tenant (e.g. USM's M365 tenant)
NEXT_PUBLIC_MICROSOFT_TENANT=common

# -----------------------------------------------------------------------------
# Convex
# Source: `bunx convex dev` first run prints these, or read from .env.local
# that the Convex CLI writes for you. Keep `CONVEX_URL` public for the
# browser; the deploy key (if you use one) stays server-side.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=

# -----------------------------------------------------------------------------
# Super-admin bootstrap
# Used once by `convex/admins.ts:bootstrapSuperAdmin` to seed the very first
# admin. Pick any long random string (e.g. `openssl rand -hex 32`).
# After the first super admin exists, this token becomes inert.
# -----------------------------------------------------------------------------
SUPER_ADMIN_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# Dev seeder (Convex deployment env only — DO NOT set on production)
# When set to "true" on a Convex dev deployment, unlocks `convex/dev.ts`
# mutations that an admin can use to populate synthetic voters,
# whitelist entries, internal evaluations, and public votes for end-to-end
# testing without needing many real @student.usm.my accounts.
# Leave UNSET on production. See docs/TESTING.md for full usage.
# -----------------------------------------------------------------------------
DEV_SEED_ALLOWED=
